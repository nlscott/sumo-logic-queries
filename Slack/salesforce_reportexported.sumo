// SALESFORCE --------------------------------------------------------------------------------------
// Large Report Exported
_sourceCategory="salesforce" 
    | PARSEDATE(TIMESTAMP_DERIVED, "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'","Etc/UCT") as milliseconds
    | FORMATDATE(milliseconds, "MM-dd-yyyy HH:mm:ss zzz", "Etc/UCT") as timestamp_utc
    | FORMATDATE(milliseconds, "MM-dd-yyyy HH:mm:ss zzz", "America/New_York") as timestamp_est
    | RUN_TIME as RUN_TIME_MS
    | (RUN_TIME / 1000) as RUN_TIME_SEC
    | ROUND(RUN_TIME_SEC, 2) as RUN_TIME_SEC
    | WHERE ORIGIN = "ReportExported"
    | num(ROW_COUNT) as ROW_COUNT
    | WHERE ROW_COUNT >= 100000
    | COUNT by timestamp_utc, USER_ID_DERIVED_LOOKUP, REPORT_ID_DERIVED_LOOKUP, ROW_COUNT, RUN_TIME_SEC, RUN_TIME_MS, 
        CPU_TIME,DB_BLOCKS,DB_CPU_TIME,NUMBER_COLUMNS
    | SORT by ROW_COUNT




// SALESFORCE performance anomalies ----------------------------------------------------------------
// Anomaly: If one line jumps significantly higher than the others (or its own history), 
// investigate that user's activity during that hour.
_sourceCategory=salesforce
    | JSON "RUN_TIME", "USER_ID_DERIVED_LOOKUP" NODROP 
    | WHERE ORIGIN = "ReportExported"             
    | TIMESLICE 1h                              
    | AVG(RUN_TIME) as AvgRunTime by _timeslice, USER_ID_DERIVED_LOOKUP
    | TRANSPOSE row _timeslice column USER_ID_DERIVED_LOOKUP   



// SALESFORCE - Report Performance -----------------------------------------------------------------
// highlights users who consistently run slow reports
_sourceCategory=salesforce
    | JSON "RUN_TIME", "USER_ID_DERIVED_LOOKUP" NODROP 
    | WHERE ORIGIN = "ReportExported"                                          
    | AVG(RUN_TIME) as AvgRunTime, count as QueryCount by USER_ID_DERIVED_LOOKUP
    | SORT by AvgRunTime desc
    | LIMIT 10
    | WHERE QueryCount > 5   




// SALESFORCE - Performance Outliers ---------------------------------------------------------------
// If the total runtime jumps outside the band, it is a mathematically significant spike (potential DoS)
_sourceCategory=salesforce
    | JSON "RUN_TIME", "ORIGIN", "USER_ID_DERIVED_LOOKUP" NODROP
    | WHERE ORIGIN = "ReportExported"
    | (RUN_TIME / 1000) as RunTimeSeconds 
    | TIMESLICE 10m
    | SUM(RunTimeSeconds) as TotalLoadSeconds by _timeslice
    | OUTLIER TotalLoadSeconds window=10,threshold=3,consecutive=1,direction=+



// SALESFORCE --------------------------------------------------------------------------------------
// report types
_sourceCategory=salesforce
    | JSON "CLIENT_IP", "DISPLAY_TYPE", "EVENT_TYPE", "ORIGIN" NODROP
    | JSON "ROW_COUNT", "RUN_TIME", "TIMESTAMP_DERIVED" NODROP
    | JSON "USER_TYPE", "USER_ID_DERIVED_LOOKUP", "RENDERING_TYPE" NODROP
    | WHERE EVENT_TYPE in ("Report", "ReportExport", "BulkApi", "BulkApi2")
    | WHERE !(isBlank(RENDERING_TYPE))
    | IF(RENDERING_TYPE = "C", "CSV", 
        IF (RENDERING_TYPE = "X", "Excel",
        IF (RENDERING_TYPE = "P", "Printable", 
        IF (RENDERING_TYPE = "W", "Web",
        IF (RENDERING_TYPE = "E", "Email",
        IF (RENDERING_TYPE = "J", "Json", "Unknown")))))) as RENDERING_TYPE 
    | count by TIMESTAMP_DERIVED, USER_ID_DERIVED_LOOKUP, EVENT_TYPE, CLIENT_IP, RENDERING_TYPE



// SALESFORCE --------------------------------------------------------------------------------------
// alerts if a human user (Standard) exports more than 100K rows or 5 export jobs in a short window
_sourceCategory=salesforce
    | JSON "CLIENT_IP", "DISPLAY_TYPE", "EVENT_TYPE", "ORIGIN" NODROP
    | JSON "ROW_COUNT", "RUN_TIME", "TIMESTAMP_DERIVED" NODROP
    | JSON "USER_TYPE", "USER_ID_DERIVED_LOOKUP", "RENDERING_TYPE" NODROP
    | WHERE EVENT_TYPE in ("Report")
    | WHERE ORIGIN = "ReportExported"
    | WHERE USER_TYPE = "Standard" 
    | num(ROW_COUNT) as Rows
    | WHERE CLIENT_IP != "44.234.233.60"
    | TIMESLICE 10m
    | COUNT as ExportCount, 
        SUM(Rows) as TotalRowsExfiltrated,
        VALUES(CLIENT_IP)as CLIENT_IPs ,
        VALUES(SESSION_KEY)as SESSION_KEYs,
        VALUES(URI)as URIs  
        by _timeslice, USER_ID_DERIVED_LOOKUP,CLIENT_IPs,SESSION_KEYs,URIs
    | WHERE (TotalRowsExfiltrated > 1000000 OR ExportCount >= 5)